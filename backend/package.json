{
  "name": "network-lab-conductor",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json",
    "gen-types": "json2ts -i schemas/labv2.schema.json -o src/types/spec.generated.d.ts",
